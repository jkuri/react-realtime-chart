{
  "name": "react-realtime-chart",
  "version": "0.7.1",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "A lightweight, customizable real-time chart component for React applications based on WebGL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkuri/react-realtime-chart.git"
  },
  "keywords": ["react", "chart", "realtime", "d3", "visualization", "time-series", "data-visualization", "WebGL"],
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "preview": "vite preview",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.1.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.15.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.5",
    "tw-animate-css": "^1.2.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vite-plugin-checker": "^0.9.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "author": {
    "name": "Jan Kuri",
    "email": "jkuri88@gmail.com"
  },
  "license": "MIT",
  "readme": "README.md"
}
